        {
          "id": "v4",
          "text": "Material gemäss Meldebild bereitgestellt",
          "info": "Notfallrucksack, Monitor/Defibrillator, Sauerstoff, Absaugung, Trage/Tragestuhl."
        },
        {
          "id": "v5",
          "text": "Nachforderung frühzeitig geprüft",
          "info": "Notarzt, REGA, Polizei, Feuerwehr, weitere Rettungsmittel."
